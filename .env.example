# Variáveis do docker compose e dos CLIs contra o Supabase. Copie para .env na
# raiz (nunca vai para o git). A lista completa da API está em apps/api/.env.example.

# Supabase: pooler em modo SESSION (porta 5432), não o transaction (6543).
# Senha com caractere especial vai codificada na URL (@ → %40).
#   postgres://postgres.<ref>:<senha>@aws-1-<regiao>.pooler.supabase.com:5432/postgres
# Perfil local: postgres://postgres:postgres@db:5432/postgres
DATABASE_URL=

# 32+ caracteres aleatórios: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Imagens e arquivos: gravados no volume "uploads" da VPS e servidos em /uploads.
# Origem pública das URLs (o app mobile precisa de URL absoluta). Local: http://localhost:8082
STORAGE_PUBLIC_BASE_URL=

# Não usadas pela API: token pessoal do Supabase CLI (sbp_…), só para migrations pelo CLI.
SUPABASE_ACCESS_TOKEN=

# Origem do painel. Atrás de HTTPS, use COOKIE_SECURE=true.
CORS_ORIGINS=http://localhost:8082
COOKIE_SECURE=false

# Login social do app (client ids separados por vírgula). Vazio = desligado (503).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# E-mail do "esqueci a senha" do app. O compose roda em produção: sem MAIL_DRIVER
# a rota responde 503. smtp exige MAIL_FROM e SMTP_URL (ou SMTP_HOST/PORT/USER/PASSWORD).
MAIL_DRIVER=
MAIL_FROM="ARP <nao-responda@arp.com.br>"
SMTP_URL=

# Cria cargos, admin, textos e as lojas do site da ARP (uma vez).
SEED_ON_START=true
SEED_ADMIN_PASSWORD=
