# Copie para apps/api/.env (o .env nunca vai para o git).
# Os scripts db:* e o dev da API carregam este arquivo automaticamente.

# --- API -----------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Atrás de proxy (nginx): true, número de saltos (ex.: 1) ou lista de IPs/CIDRs.
TRUST_PROXY=false
# Origens aceitas pelo CORS, separadas por vírgula (em produção o web usa a mesma origem via nginx).
CORS_ORIGINS=http://localhost:5173,http://localhost:8082
# Cookie do refresh com Secure. Vazio = ligado só em NODE_ENV=production.
COOKIE_SECURE=

# --- Autenticação ----------------------------------------------------------

# Segredo HS256 dos access tokens (32+ caracteres). Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ISSUER=arp-api
ACCESS_TOKEN_TTL_SECONDS=900
# Validade do refresh token (rotativo) do painel e do app.
REFRESH_TOKEN_TTL_DAYS=30
APP_REFRESH_TOKEN_TTL_DAYS=90
# Segundos em que o refresh anterior ainda vale logo após a troca (resposta perdida). 0 = sem.
REFRESH_REUSE_GRACE_SECONDS=60

# Login social do app: client ids aceitos no id_token, separados por vírgula
# (um por plataforma: iOS, Android, web). Vazio = provedor desligado (503).
GOOGLE_CLIENT_IDS=
# Apple: bundle id do app (e o Services ID, se houver login pela web).
APPLE_CLIENT_IDS=

# "Esqueci a senha" do app: validade do código de 6 dígitos (5 a 60 min).
PASSWORD_RESET_CODE_TTL_MINUTES=15
# Segredo do HMAC dos códigos (32+ caracteres). Vazio = derivado do JWT_ACCESS_SECRET.
PASSWORD_RESET_SECRET=

# --- E-mail ----------------------------------------------------------------

# log: o e-mail vai para o log da API (padrão fora de produção; o código aparece lá).
# smtp: envia de verdade. Em produção sem valor, "esqueci a senha" responde 503.
MAIL_DRIVER=
# Remetente (obrigatório com smtp).
MAIL_FROM="ARP <nao-responda@arp.com.br>"
# smtp(s)://usuario:senha@host:porta (tem prioridade) ou host/porta/usuário/senha.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
# TLS direto. Vazio = ligado só na porta 465 (as outras usam STARTTLS).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# --- Limites ---------------------------------------------------------------

# Global: RATE_LIMIT_MAX por usuário/visitante com token; sem token, RATE_LIMIT_IP_MAX
# por IP (mais alto: no wi-fi do complexo muitos visitantes saem pelo mesmo IP).
RATE_LIMIT_MAX=300
RATE_LIMIT_IP_MAX=1200
RATE_LIMIT_WINDOW=1 minute
# Login (painel e app) por IP + e-mail.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=5 minutes
# Upload de imagem (máximo 5 MB, o limite do contrato).
UPLOAD_MAX_BYTES=5242880
# Cache do dashboard por instância (0 = sem cache).
DASHBOARD_CACHE_TTL_SECONDS=60

# --- Subida ----------------------------------------------------------------

RUN_MIGRATIONS_ON_START=true
# true = roda o seed idempotente na subida (exige SEED_ADMIN_PASSWORD).
SEED_ON_START=false
# Jobs: expirar cupons pegos, enviar notificações agendadas, limpar sessões e
# códigos de nova senha vencidos (e o contador de rate limit, com RATE_LIMIT_STORE=postgres).
JOBS_ENABLED=true

# --- Banco (Postgres) ----------------------------------------------------

# Dev: `docker compose --profile local up -d db` sobe um Postgres nesta URL.
# Supabase: use o pooler em modo SESSION (porta 5432), não o transaction (6543):
# a API usa advisory locks e prepared statements, que exigem sessão fixa.
#   postgres://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Conexões por instância da API (o pooler do Supabase tem limite por projeto).
DB_POOL_MAX=10

# auto (padrão): SSL ligado quando o host não é local.
# require: cifra sem validar o certificado | verify: valida (use DB_SSL_CA) | off: sem SSL.
DB_SSL=auto
# Certificado CA em PEM (só com DB_SSL=verify; baixe no painel do Supabase).
DB_SSL_CA=

# Consultas mais longas que isso são canceladas pelo Postgres (0 = sem limite).
DB_STATEMENT_TIMEOUT_MS=30000

# Pasta das migrations. Vazio = procura supabase/migrations subindo pastas
# (funciona em dev; no container copie para /app/supabase/migrations ou defina aqui).
MIGRATIONS_DIR=

# --- Imagens ---------------------------------------------------------------

# supabase (produção) | local (dev offline, grava em disco e a API serve em /uploads).
STORAGE_DRIVER=local

# Driver local: pasta (relativa ao diretório de trabalho da API) e prefixo das URLs.
STORAGE_LOCAL_DIR=storage/uploads
STORAGE_LOCAL_PUBLIC_PATH=/uploads

# Driver supabase. A service role key fica SÓ no servidor (nunca no web/app).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket público criado automaticamente na subida, se não existir.
SUPABASE_STORAGE_BUCKET=media

# --- Seed (npm run db:seed) --------------------------------------------------

# Senha do admin@arp.com.br criado pelo seed
# (8+ caracteres, com letra e número). Só é usada ao CRIAR o usuário.
SEED_ADMIN_PASSWORD=
# Dados fictícios de demonstração no painel (o app não mostra). false apaga.
SEED_DEMO_DATA=true

# --- Escala (ver docs/escalabilidade.md) -------------------------------------

# memory (padrão, por réplica) | postgres (rotas sensíveis contam numa tabela UNLOGGED compartilhada)
RATE_LIMIT_STORE=memory
# Pegar cupom / ler QR, por visitante.
ACTION_RATE_LIMIT_MAX=30
ACTION_RATE_LIMIT_WINDOW=1 minute

# Cache das leituras públicas do app (home, lojas, mapa, agenda, cupons, desafios). 0 = sem cache.
APP_CACHE_TTL_SECONDS=15
CACHE_MAX_ENTRIES=5000
# local (padrão) | postgres (LISTEN/NOTIFY avisa as outras réplicas; uma conexão a mais por réplica)
CACHE_INVALIDATION=local
# Exibições/cliques de destaque acumulados em memória e gravados a cada N ms.
HIGHLIGHT_METRICS_FLUSH_MS=5000

# Servidor HTTP
HTTP_REQUEST_TIMEOUT_MS=60000
# Maior que o keepalive do proxy/balanceador (nginx/ALB: 60 s).
HTTP_KEEP_ALIVE_TIMEOUT_MS=72000
HTTP_BODY_LIMIT_BYTES=1048576
# gzip/br nas respostas JSON (o app chama a API direto).
HTTP_COMPRESSION=true
# SIGTERM: readiness vira 503 e espera isto antes de fechar (use ~5000 atrás de balanceador).
SHUTDOWN_DRAIN_MS=0
SHUTDOWN_TIMEOUT_MS=20000
# GET /metrics (Prometheus). Com METRICS_TOKEN, exige Authorization: Bearer <token>.
METRICS_ENABLED=false
METRICS_TOKEN=

# Banco: timeouts por sessão e pool
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Abrir conexão OU esperar uma livre no pool cheio; estourou = 503 com Retry-After.
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_MAX_LIFETIME_SECONDS=1800
DB_SLOW_QUERY_MS=500
